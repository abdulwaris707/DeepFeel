# DEEPFEEL PRODUCTION ENVIRONMENT CONFIGURATION EXAMPLE

NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://deepfeel_user:secure_password_here@localhost:5432/deepfeel_db

# JWT & SESSION SECRETS (Generate random 64-char strings in production)
JWT_SECRET=super_secret_jwt_key_deepfeel_pakistan_2026_change_in_prod
SESSION_SECRET=super_secret_session_key_deepfeel_pakistan_2026_change_in_prod

# ALLOWED ORIGINS (Comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,https://deepfeel.pk

# INITIAL ADMIN SETUP (Auto-seeded if no admin exists)
INITIAL_ADMIN_EMAIL=admin@deepfeel.pk
INITIAL_ADMIN_PASSWORD=AdminSecurePass2026!

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
